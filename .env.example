# 复制本文件为 .env 并填入真实值。.env 绝不提交！
# ===== 阿里云百炼 Embedding（RAG 检索）=====
DASHSCOPE_API_KEY=
WORKSPACE_ID=
DASHSCOPE_BASE_URL=https://{WORKSPACE_ID}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://{WORKSPACE_ID}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ===== 智谱 GLM（回答生成）=====
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_MAIN=glm-4.7-flash
ZHIPU_MODEL_FAST=glm-4-flash

# ===== SenseNova 免费网关（兜底）=====
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_KEYS=
SENSENOVA_MODEL_DEEPSEEK=deepseek-v4-flash
SENSENOVA_MODEL_GLM=glm-5.2

# ===== Uniapi（备用）=====
UNIAPI_KEY=
