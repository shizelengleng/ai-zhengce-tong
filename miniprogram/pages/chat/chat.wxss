/* chat.wxss —— 聊天页样式（原生 tabBar 模式：不写 100vh，避免输入栏被 tabBar 盖住） */
.container {
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F5F6FA;
  box-sizing: border-box;
}

/* 消息列表：height:0 + flex:1 是 flex 滚动容器的标准 hack，
   让 scroll-view 在 flex 父容器里获得明确可滚动高度 */
.msg-list {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg-item {
  display: flex;
  margin-bottom: 24rpx;
}
.msg-item.user {
  justify-content: flex-end;
}
.msg-item.ai {
  justify-content: flex-start;
}

/* 气泡 */
.bubble {
  max-width: 75%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}
.bubble.user {
  background: #3A7AFE;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.bubble.ai {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.bubble-text {
  white-space: pre-wrap;
}

/* 出处卡片 */
.sources {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}
.sources-title {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}
.source-item {
  background: #F7FAFF;
  border: 1rpx solid #D7E4FB;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.source-item:last-child { margin-bottom: 0; }
.source-main {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.source-title {
  color: #222;
  font-weight: 500;
  font-size: 26rpx;
}
.source-docno {
  color: #3A7AFE;
  background: #E8F0FF;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}
.source-meta {
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.meta-source { color: #555; }
.meta-phone  { color: #FA8C16; }
.meta-link   { color: #52C41A; }
.msg-bottom-pad { height: 16rpx; }

/* 加载态 */
.bubble.loading {
  display: flex;
  align-items: center;
}
.loading-text {
  color: #999;
  margin-right: 8rpx;
}
.dots {
  display: flex;
  align-items: center;
}
.dot {
  width: 10rpx;
  height: 10rpx;
  background: #999;
  border-radius: 50%;
  margin: 0 4rpx;
  animation: bounce 1.2s infinite;
}
.dot:nth-child(2) {
  animation-delay: 0.2s;
}
.dot:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes bounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

/* 快捷问题 */
.quick-questions {
  white-space: nowrap;
  padding: 12rpx 24rpx;
}
.quick-item {
  display: inline-block;
  background: #fff;
  color: #3A7AFE;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
  border: 1rpx solid #3A7AFE;
}
.quick-item:last-child {
  margin-right: 24rpx;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}
.input {
  flex: 1;
  background: #F5F6FA;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx;
  background: #3A7AFE;
  color: #fff;
  font-size: 28rpx;
  padding: 8rpx 32rpx;
  border-radius: 999rpx;
  line-height: 2;
}
.send-btn::after {
  border: none;
}
.send-btn.disabled {
  background: #A0BFFF;
}
