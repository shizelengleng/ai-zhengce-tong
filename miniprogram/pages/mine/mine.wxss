/* mine.wxss —— 我的页样式（融合版：用户卡片 + 数据统计 + 历史 + 功能菜单） */

.container {
  padding: 24rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #1565C0 0%, #1E88E5 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(30,136,229,0.25);
}
.user-card-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
}
.user-info {
  flex: 1;
}
.user-name {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.user-desc {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
}
.user-card-actions {
  display: flex;
  gap: 16rpx;
}
.user-action-btn {
  flex: 1;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
  text-align: center;
  border: 1rpx solid rgba(255,255,255,0.3);
}

/* 我的数据统计（白色卡片） */
.stats-card-white {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  border: 1rpx solid #E8E8E8;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.stats-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #F0F0F0;
}
.stats-item:last-child {
  border-right: none;
}
.stats-item-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.stats-item-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}
.stats-item-label {
  font-size: 22rpx;
  color: #999;
}

/* 区块 */
.section {
  margin-bottom: 24rpx;
}
.clickable-title {
  color: #1565C0;
}

/* 历史记录 */
.history-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #E8E8E8;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.history-item {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.history-item:last-child {
  border-bottom: none;
}
.history-q-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.history-q {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  flex: 1;
  padding-right: 16rpx;
}
.expand-hint {
  font-size: 22rpx;
  color: #1565C0;
  white-space: nowrap;
  flex-shrink: 0;
}
.history-time {
  font-size: 22rpx;
  color: #BBB;
}

/* 答案展开区 */
.history-a-box {
  margin: 14rpx 0 12rpx 0;
  padding: 20rpx 24rpx;
  background: #F5F9FF;
  border-radius: 12rpx;
  border-left: 4rpx solid #1E88E5;
}
.history-a {
  font-size: 26rpx;
  color: #333;
  line-height: 1.65;
  white-space: pre-wrap;
}
.history-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}
.reask-btn {
  background: linear-gradient(135deg, #1565C0, #1E88E5);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(30,136,229,0.25);
}

/* 功能菜单 */
.menu-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #E8E8E8;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: #F8F9FA;
}
.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #F0F4F8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.menu-info {
  flex: 1;
  min-width: 0;
}
.menu-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 4rpx;
}
.menu-desc {
  font-size: 22rpx;
  color: #999;
}
.menu-arrow {
  font-size: 36rpx;
  color: #CCC;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.menu-remove {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F0F0F0;
  color: #999;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.mine-bottom-pad {
  height: 40rpx;
}

/* loading 占位 */
.loading-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}
.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}
