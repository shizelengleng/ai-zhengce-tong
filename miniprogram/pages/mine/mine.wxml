<!-- mine.wxml —— 我的页（历史记录显示答案+点击展开+再问一次+去掉假登录） -->
<view class="container">
  <!-- 用户卡片（去掉假登录，改为产品标识） -->
  <view class="user-card">
    <view class="avatar">📄</view>
    <view class="user-info">
      <view class="user-name">AI政策通</view>
      <view class="user-desc">天河区社区便民政策问答助手</view>
    </view>
  </view>

  <!-- 问答历史 -->
  <view class="section">
    <view class="section-title">问答历史</view>

    <!-- loading -->
    <view wx:if="{{loading}}" class="loading-box">
      <view class="loading-text">加载中…</view>
    </view>

    <!-- 历史列表 -->
    <view wx:elif="{{history.length}}" class="history-list">
      <view wx:for="{{history}}" wx:key="_id" class="history-item" bindtap="onHistoryTap" data-id="{{item._id}}">
        <text class="history-q" user-select="true">{{item.question}}</text>
        <!-- 展开时显示答案 -->
        <view wx:if="{{expandedId === item._id}}" class="history-a-box">
          <text class="history-a" user-select="true">{{item.answer}}</text>
          <view class="history-actions">
            <view class="reask-btn" catchtap="onReaskTap" data-q="{{item.question}}">再问一次</view>
          </view>
        </view>
        <text class="history-time" user-select="true">{{item.create_time}}</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:else class="empty">暂无历史记录</view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-title">关于</view>
    <view class="about-card">
      <view class="about-text">AI政策通 · 天河区政策问答助手</view>
      <view class="about-version">版本 v0.2.0</view>
    </view>
  </view>
</view>
