/* custom-tab-bar/index.wxss */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  border-top: 1rpx solid #eee;
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}
.tab-icon {
  font-size: 36rpx;
  line-height: 1;
  margin-bottom: 6rpx;
  opacity: 0.5;
}
.tab-text {
  font-size: 22rpx;
  color: #999;
}
.tab-item.active .tab-icon {
  opacity: 1;
}
.tab-item.active .tab-text {
  color: #3A7AFE;
  font-weight: 500;
}
