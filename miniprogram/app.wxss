/* app.wxss —— 全局样式 · AI政策通 */

page {
  background-color: #F5F6FA;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

/* 主按钮 */
.btn-primary {
  background: #3A7AFE;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  margin-top: 24rpx;
}
.btn-primary::after {
  border: none;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  color: #3A7AFE;
  margin-right: 12rpx;
}
.tag-keyword {
  background: #F0F0F0;
  color: #666;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 26rpx;
}
