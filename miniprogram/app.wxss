/* app.wxss —— 全局样式 · AI政策通（融合版：精致商务 × 数据卡片） */

page {
  background: #F5F7FA;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 —— 精致商务风：圆角16px + 细边框 + 轻阴影 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #E8E8E8;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 主按钮 —— 蓝色渐变 + 蓝阴影 */
.btn-primary {
  background: linear-gradient(135deg, #1565C0 0%, #1E88E5 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 22rpx 0;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(30,136,229,0.25);
}
.btn-primary::after {
  border: none;
}

/* 次级按钮 —— 白底蓝边 */
.btn-secondary {
  background: #fff;
  color: #1565C0;
  border: 1rpx solid #1565C0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 22rpx 0;
  margin-top: 16rpx;
}
.btn-secondary::after {
  border: none;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #E3F2FD;
  color: #1565C0;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
.tag-keyword {
  background: #F0F0F0;
  color: #666;
}
.tag-success {
  background: #E8F5E9;
  color: #43A047;
}
.tag-warning {
  background: #FFF3E0;
  color: #FB8C00;
}

/* 区块标题 —— 蓝色竖线 + 粗体 */
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #1565C0, #1E88E5);
  border-radius: 3rpx;
  margin-right: 12rpx;
}
.section-title .title-extra {
  margin-left: auto;
  font-size: 24rpx;
  color: #888;
  font-weight: normal;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #F0F2F5;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 20rpx;
}
.search-bar .search-icon {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
}
.search-bar .search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
}
.search-bar .search-placeholder {
  flex: 1;
  font-size: 26rpx;
  color: #999;
}

/* 数据统计卡片 */
.stats-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.stats-card {
  flex: 1;
  background: rgba(255,255,255,0.18);
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
}
.stats-card .stats-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.2;
}
.stats-card .stats-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

/* 蓝色顶部延伸区域 */
.blue-hero {
  background: linear-gradient(180deg, #1565C0 0%, #1E88E5 100%);
  margin: -24rpx -24rpx 0 -24rpx;
  padding: 24rpx 24rpx 40rpx 24rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

/* loading 占位 */
.loading-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}
.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #E8E8E8;
  margin: 20rpx 0;
}

/* 文字颜色工具类 */
.text-primary { color: #1565C0; }
.text-secondary { color: #555; }
.text-muted { color: #888; }
.text-light { color: #BBB; }
.text-success { color: #43A047; }
.text-warning { color: #FB8C00; }
.text-danger { color: #E53935; }

/* 字体大小工具类 */
.fs-xs { font-size: 22rpx; }
.fs-sm { font-size: 24rpx; }
.fs-md { font-size: 28rpx; }
.fs-lg { font-size: 32rpx; }
.fs-xl { font-size: 36rpx; }
.fs-xxl { font-size: 40rpx; }
.fw-bold { font-weight: bold; }
.fw-medium { font-weight: 500; }

/* ========== 骨架屏 ========== */
.skeleton-container {
  padding: 0;
}
.skeleton-search {
  height: 64rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
}
.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.skeleton-cat-card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 16rpx;
  text-align: center;
  border: 1rpx solid #E8E8E8;
}
.skeleton-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin: 0 auto 14rpx;
}
.skeleton-line {
  height: 24rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 6rpx;
  margin: 0 auto 10rpx;
}
.skeleton-line.long { width: 100%; }
.skeleton-line.medium { width: 60%; }
.skeleton-line.short { width: 50%; }
.skeleton-line.xshort { width: 30%; }
.skeleton-list-title {
  height: 32rpx;
  width: 40%;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}
.skeleton-list-item {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #E8E8E8;
  border-left: 5rpx solid #e8e8e8;
}
.skeleton-history-item {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.skeleton-history-item .skeleton-line {
  margin: 0 0 10rpx 0;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
